{% comment %}
  Local override of al_folio_cv gem template (v1.0.0), templates/cv/experience.liquid.
  Changes from upstream:
  - Date badge shows "Mon YYYY" when a month is available, instead of year-only.
  - Date column widened (col-*-2 -> col-*-3) and badge min-width increased so the
    longer month+year range doesn't wrap onto a second line.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-4 col-sm-3 col-md-3 text-center date-column">
          {% comment %} `capture` keeps the surrounding whitespace, so strip before testing for emptiness {% endcomment %}
          {% capture start_date %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% assign start_date = start_date | strip %}
          {% capture end_date %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign end_date = end_date | strip %}
          {% comment %}
            An entry may carry a single point-in-time `date` instead of a start/end pair. `al_cv_sort_by_date` already
            orders on it, so render it too rather than silently dropping the badge.
          {% endcomment %}
          {% capture point_date %}
            {% if entry.date %}{{ entry.date }}{% elsif entry.releaseDate %}{{ entry.releaseDate }}{% endif %}
          {% endcapture %}
          {% assign point_date = point_date | strip %}

          {% if start_date != '' %}
            {% capture startDate %}{% include cv/format_cv_date.liquid date_in=start_date %}{% endcapture %}
            {% assign startDate = startDate | strip %}
            {% if end_date != '' %}
              {% capture endDate %}{% include cv/format_cv_date.liquid date_in=end_date %}{% endcapture %}
              {% assign endDate = endDate | strip %}
            {% else %}
              {% assign endDate = 'Present' %}
            {% endif %}
            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% elsif point_date != '' %}
            {% comment %} A standalone date is a point in time, never an open-ended range {% endcomment %}
            {% capture date %}{% include cv/format_cv_date.liquid date_in=point_date %}{% endcapture %}
            {% assign date = date | strip %}
          {% else %}
            {% assign date = null %}
          {% endif %}

          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if date %}
                    <span
                      class="badge font-weight-bold danger-color-dark text-uppercase align-middle"
                      style="min-width: 150px; white-space: nowrap"
                    >
                      {{ date }}
                    </span>
                  {% endif %}
                </td>
              </tr>
              {% capture location %}
                {% if entry.location %}{{ entry.location }}{% endif %}
              {% endcapture %}
              {% assign location = location | strip %}
              {% if location != '' %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-8 col-sm-9 col-md-9 mt-2 mt-md-0">
          {% capture position_title %}
            {% if entry.position %}{{ entry.position }}{% endif %}
          {% endcapture %}

          {% if entry.url %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ position_title }}</a>
            </h6>
          {% elsif position_title != '' %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ position_title }}</h6>
          {% endif %}

          {% capture company_name %}
            {% if entry.name %}{{ entry.name }}{% elsif entry.company %}{{ entry.company }}{% elsif entry.organization %}{{ entry.organization }}{% endif %}
          {% endcapture %}
          {% if company_name != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ company_name }}</h6>
          {% endif %}

          {% if entry.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">
              {{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}
            </h6>
          {% endif %}

          {% if entry.highlights %}
            <ul class="items">
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
